#!/bin/sh
set -e
lb config noauto \
  --distribution bookworm \
  --archive-areas "main contrib non-free non-free-firmware" \
  --binary-images iso-hybrid \
  --debian-installer none \
  --apt-recommends false \
  --bootappend-live "boot=live components quiet hostname=oblvn-agent" \
  --iso-application "OBLVN Wipe Agent" \
  --iso-volume "OBLVN_AGENT" \
  "${@}"
